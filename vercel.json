{
  "framework": "vite",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "rewrites": [
    {
      "source": "/projects/thread",
      "destination": "/projects/thread.html"
    },
    {
      "source": "/projects/relay",
      "destination": "/projects/relay.html"
    },
    {
      "source": "/projects/fieldnotes",
      "destination": "/projects/fieldnotes.html"
    },
    {
      "source": "/projects",
      "destination": "/projects.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/colophon",
      "destination": "/colophon.html"
    },
    {
      "source": "/((?!assets/|fonts/|projects/.*\\.png|.*\\.(?:svg|webp|png|woff2|xml|txt|webmanifest)$).*)",
      "destination": "/index.html"
    }
  ]
}
