{
  "name": "quiet-systems-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-documents.mjs",
    "preview": "vite preview",
    "routes:generate": "tsr generate",
    "typecheck": "pnpm routes:generate && tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "test": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm build && pnpm test && pnpm test:base-path",
    "assets:fonts": "node scripts/prepare-assets.mjs",
    "assets:projects": "node scripts/capture-projects.mjs",
    "test:hosted": "node scripts/hosted-qa.mjs",
    "test:base-path": "node scripts/verify-base-path.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.41",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.40",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "knip": "^6.39.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
