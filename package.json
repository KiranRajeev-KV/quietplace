{
  "name": "betweenleaf",
  "version": "0.1.0",
  "private": true,
  "description": "A quiet home for work and writing.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-documents.mjs",
    "preview": "vite preview",
    "routes:generate": "tsr generate",
    "typecheck": "pnpm routes:generate && tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "test": "pnpm db:migrate && playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm build && pnpm test && pnpm test:base-path",
    "assets:fonts": "node scripts/prepare-assets.mjs",
    "assets:projects": "node scripts/capture-projects.mjs",
    "test:base-path": "node scripts/verify-base-path.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@platejs/basic-nodes": "^53.0.0",
    "@platejs/caption": "^53.0.0",
    "@platejs/code-block": "^53.0.0",
    "@platejs/indent": "^53.0.0",
    "@platejs/link": "^53.3.5",
    "@platejs/list": "^53.3.13",
    "@platejs/markdown": "^53.3.15",
    "@platejs/media": "^53.1.4",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "browser-image-compression": "^2.0.2",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.13",
    "idb-keyval": "^6.3.0",
    "image-size": "^2.0.4",
    "lowlight": "^3.3.0",
    "platejs": "^53.3.15",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/workers-types": "^5.20261005.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.40",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "knip": "^6.39.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.4.2"
}
